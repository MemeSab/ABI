{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/podcast",
      "dest": "/podcast.html"
    },
    {
      "src": "/brand-suite",
      "dest": "/brand-suite.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}